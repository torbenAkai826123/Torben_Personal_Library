<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>Library.Tests</AssemblyName>
    <!-- Log.Debug 帶 [Conditional], 測試專案沒有 UNITY_EDITOR, 需定義此 symbol 才會保留呼叫 -->
    <DefineConstants>$(DefineConstants);TORBEN_LOG_DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- NUnit 3.x: 與 Unity Test Framework 的 Assert 寫法相容 -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Torben.Core/Torben.Core.csproj" />
  </ItemGroup>

</Project>
